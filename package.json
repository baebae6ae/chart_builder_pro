{
  "name": "chart-builder-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drag-and-drop data visualization studio that exports editable, native PowerPoint charts. Built for Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "echarts": "^5.6.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
